        function switchLanguage(lang) {
            currentLang = lang;
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.textContent === (lang === 'ja' ? '日本語' : '中文'));
            });
            updateTexts();
            renderCategoryFilter();
            renderPortfolios();
        }

        function updateTexts() {
            const t = texts[currentLang];
            document.getElementById('tagline').textContent = t.tagline;
            document.getElementById('categoryTitle').textContent = t.categoryTitle;
            document.getElementById('manageCatBtn').textContent = t.manage;
            document.getElementById('viewAll').textContent = t.all;
            document.getElementById('viewImage').textContent = t.imageWorks;
            document.getElementById('viewText').textContent = t.textWorks;
            document.getElementById('addBtn').textContent = t.addWork;
            document.getElementById('manageCatTitle').textContent = t.manageCat;
            document.getElementById('addCatBtn').textContent = t.addCat;
            document.getElementById('catCancelBtn').textContent = t.cancel;
            document.getElementById('catSaveBtn').textContent = t.save;
            document.getElementById('labelCategory').textContent = t.category;
            document.getElementById('labelTitle').textContent = t.title;
            document.getElementById('labelDesc').textContent = t.description;
            document.getElementById('optional1').textContent = t.optional;
            document.getElementById('optional2').textContent = t.optional;
            document.getElementById('optional3').textContent = t.optional;
            document.getElementById('optional4').textContent = t.optional;
            document.getElementById('labelTags').textContent = t.customTags;
            document.getElementById('labelImage').textContent = t.image;
            document.getElementById('labelLink').textContent = t.link;
            document.getElementById('uploadText').textContent = t.uploadText;
            document.getElementById('uploadHint').textContent = t.uploadHint;
            document.getElementById('removeImgBtn').textContent = t.removeImg;
            document.getElementById('cancelBtn').textContent = t.cancel;
            document.getElementById('saveBtn').textContent = t.save;
            document.getElementById('editBtn').textContent = t.edit;
            document.getElementById('deleteBtn').textContent = t.delete;
            document.getElementById('title').placeholder = t.titlePlaceholder;
            document.getElementById('description').placeholder = t.descPlaceholder;
            document.getElementById('tagInput').placeholder = t.enterTag;
            
            const tagType = document.getElementById('tagType');
            tagType.options[0].textContent = t.platform;
            tagType.options[1].textContent = t.dataVolume;
            tagType.options[2].textContent = t.custom;
        }

        async function init() {
            await loadData();
            renderCategoryFilter();
            renderPortfolios();
            setupEvents();
        }

        async function loadData() {
            try {
                const catResult = await storageGet('aoraland-categories');
                if (catResult?.value) {
                    categories = JSON.parse(catResult.value);
                }
            } catch (e) {
                console.error('Load categories error:', e);
            }

            try {
                const result = await storageList('aoraland:');
                if (result?.keys && result.keys.length > 0) {
                    const promises = result.keys.map(key => storageGet(key));
                    const results = await Promise.all(promises);
                    portfolios = results
                        .filter(r => r?.value)
                        .map(r => JSON.parse(r.value))
                        .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                }
            } catch (e) {
                console.error('Load portfolios error:', e);
                portfolios = [];
            }
        }

        async function saveToStorage(portfolio) {
            try {
                console.log('Saving portfolio:', portfolio);
                const success = await storageSet(`aoraland:${portfolio.id}`, JSON.stringify(portfolio));
                if (success) {
                    console.log('Portfolio saved successfully');
                    return true;
                } else {
                    console.error('Failed to save portfolio');
                    alert('保存失败，请重试 / Save failed, please retry');
                    return false;
                }
            } catch (e) {
                console.error('Save error:', e);
                alert('保存失败：' + e.message + ' / Save failed: ' + e.message);
                return false;
            }
        }

        async function deleteFromStorage(id) {
            try {
                await storageDelete(`aoraland:${id}`);
            } catch (e) {
                console.error('Delete error:', e);
            }
        }

        async function saveCategoriesToStorage() {
            try {
                await storageSet('aoraland-categories', JSON.stringify(categories));
            } catch (e) {
                console.error('Save categories error:', e);
            }
        }

        function renderCategoryFilter() {
            const t = texts[currentLang];
            const html = `
                <button class="filter-btn ${currentFilter === 'all' ? 'active' : ''}" onclick="filterCategory('all')">${t.all}</button>
                ${categories.map(cat => `
                    <button class="filter-btn ${currentFilter === cat ? 'active' : ''}" onclick="filterCategory('${cat}')">${cat}</button>
                `).join('')}
            `;
            document.getElementById('categoryFilter').innerHTML = html;
        }

        function filterCategory(cat) {
            currentFilter = cat;
            renderCategoryFilter();
            renderPortfolios();
        }

        function filterViewType(type) {
            currentViewType = type;
            document.querySelectorAll('.view-type-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            renderPortfolios();
        }

        function renderPortfolios() {
            const t = texts[currentLang];
            let filtered = currentFilter === 'all' ? portfolios : portfolios.filter(p => p.category === currentFilter);
            
            if (currentViewType === 'image') {
                filtered = filtered.filter(p => p.image);
            } else if (currentViewType === 'text') {
                filtered = filtered.filter(p => !p.image);
            }

            const grid = document.getElementById('portfolioGrid');
            
            if (!filtered.length) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">✨</div>
                        <div class="empty-state-text">${t.noWorks}</div>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(p => {
                const tagsHtml = p.tags?.length ? `
                    <div class="card-tags">
                        ${p.tags.map(tag => `<span class="card-tag ${tag.type}-tag">${tag.text}</span>`).join('')}
                    </div>
                ` : '';
                
                return `
                    <div class="portfolio-card ${!p.image ? 'card-text-only' : ''}" onclick="viewPortfolio('${p.id}')">
                        ${p.image ? `<img src="${p.image}" class="card-image" alt="${p.title}">` : ''}
                        <div class="card-content">
                            <div class="card-category">${p.category}</div>
                            ${tagsHtml}
                            <div class="card-title">${p.title}</div>
                            ${p.description ? `<div class="card-description">${p.description}</div>` : ''}
                            ${p.link ? `<a href="${p.link}" class="card-link" onclick="event.stopPropagation()" target="_blank">${currentLang === 'ja' ? 'リンク' : '链接'} →</a>` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function openManageCategories() {
            renderCategoryManagement();
            document.getElementById('manageCategoriesModal').classList.add('active');
        }

        function closeManageCategories() {
            document.getElementById('manageCategoriesModal').classList.remove('active');
        }

        function renderCategoryManagement() {
            const t = texts[currentLang];
            document.getElementById('categoryList').innerHTML = categories.map((cat, i) => `
                <div class="category-item">
                    <input type="text" value="${cat}" onchange="categories[${i}]=this.value.trim()">
                    <button onclick="removeCategory(${i})">${t.delete}</button>
                </div>
            `).join('');
        }

        function removeCategory(index) {
            const t = texts[currentLang];
            if (categories.length <= 1) {
                alert(t.needOneCat);
                return;
            }
            if (confirm(t.confirmDeleteCat)) {
                categories.splice(index, 1);
                renderCategoryManagement();
            }
        }

        function addNewCategory() {
            const t = texts[currentLang];
            const name = prompt(t.enterCatName);
            if (name?.trim()) {
                categories.push(name.trim());
                renderCategoryManagement();
            }
        }

        async function saveCategories() {
            const t = texts[currentLang];
            await saveCategoriesToStorage();
            renderCategoryFilter();
            closeManageCategories();
            alert(t.catSaved);
        }

        function openAddModal() {
            const t = texts[currentLang];
            currentEditId = null;
            currentImageData = null;
            currentTags = [];
            document.getElementById('modalTitle').textContent = t.newWork;
            document.getElementById('portfolioForm').reset();
            document.getElementById('previewContainer').style.display = 'none';
            document.getElementById('uploadArea').style.display = 'block';
            renderTags();
            updateCategorySelect();
            document.getElementById('addModal').classList.add('active');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.remove('active');
        }

        function updateCategorySelect() {
            document.getElementById('category').innerHTML = categories.map(cat => `<option value="${cat}">${cat}</option>`).join('');
        }

        async function savePortfolio(event) {
            event.preventDefault();
            
            const title = document.getElementById('title').value.trim();
            if (!title) {
                alert('タイトルを入力してください / Please enter a title');
                return;
            }
            
            const portfolio = {
                id: currentEditId || Date.now().toString(),
                category: document.getElementById('category').value,
                title: title,
                description: document.getElementById('description').value.trim() || '',
                image: currentImageData || '',
                link: document.getElementById('link').value.trim() || '',
                tags: [...currentTags],
                createdAt: currentEditId ? portfolios.find(p => p.id === currentEditId).createdAt : new Date().toISOString()
            };

            console.log('Attempting to save:', portfolio);

            const success = await saveToStorage(portfolio);
            if (!success) {
                console.error('Save failed');
                return;
            }

            if (currentEditId) {
                const index = portfolios.findIndex(p => p.id === currentEditId);
                if (index !== -1) {
                    portfolios[index] = portfolio;
                }
            } else {
                portfolios.unshift(portfolio);
            }

            console.log('Current portfolios:', portfolios);
            
            closeAddModal();
            renderPortfolios();
        }

        function viewPortfolio(id) {
            const t = texts[currentLang];
            currentViewId = id;
            const p = portfolios.find(item => item.id === id);
            
            const tagsHtml = p.tags?.length ? `
                <div class="card-tags" style="margin-bottom:15px">
                    ${p.tags.map(tag => `<span class="card-tag ${tag.type}-tag">${tag.text}</span>`).join('')}
                </div>
            ` : '';
            
            document.getElementById('detailContent').innerHTML = `
                ${p.image ? `<img src="${p.image}" style="width:100%;max-height:400px;object-fit:contain;border-radius:15px;margin-bottom:20px;background:white">` : ''}
                <div class="card-category" style="margin-bottom:10px">${p.category}</div>
                ${tagsHtml}
                <h2 style="font-size:1.8rem;color:#5a5a5a;margin-bottom:15px;font-weight:600">${p.title}</h2>
                ${p.description ? `<div style="color:#7a7a7a;line-height:1.8;margin-bottom:20px;white-space:pre-wrap">${p.description}</div>` : ''}
                ${p.link ? `<a href="${p.link}" style="display:inline-flex;align-items:center;gap:8px;color:white;background:linear-gradient(135deg,#a8c0d8 0%,#7a9cb8 100%);text-decoration:none;padding:12px 24px;border-radius:18px" target="_blank">${t.viewLink} →</a>` : ''}
            `;
            
            document.getElementById('detailModal').classList.add('active');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.remove('active');
        }

        function editPortfolio() {
            const t = texts[currentLang];
            const p = portfolios.find(item => item.id === currentViewId);
            currentEditId = currentViewId;
            currentImageData = p.image || null;
            currentTags = p.tags ? [...p.tags] : [];
            
            document.getElementById('modalTitle').textContent = t.editWork;
            updateCategorySelect();
            document.getElementById('category').value = p.category;
            document.getElementById('title').value = p.title;
            document.getElementById('description').value = p.description || '';
            document.getElementById('link').value = p.link || '';
            
            renderTags();
            
            if (p.image) {
                document.getElementById('imagePreview').src = p.image;
                document.getElementById('previewContainer').style.display = 'block';
                document.getElementById('uploadArea').style.display = 'none';
            }
            
            closeDetailModal();
            document.getElementById('addModal').classList.add('active');
        }

        async function deletePortfolio() {
            const t = texts[currentLang];
            if (confirm(t.confirmDelete)) {
                await deleteFromStorage(currentViewId);
                portfolios = portfolios.filter(p => p.id !== currentViewId);
                closeDetailModal();
                renderPortfolios();
            }
        }

        function addTag() {
            const text = document.getElementById('tagInput').value.trim();
            const type = document.getElementById('tagType').value;
            if (text) {
                currentTags.push({ type, text });
                renderTags();
                document.getElementById('tagInput').value = '';
            }
        }

        function addPresetTag(type, text) {
            currentTags.push({ type, text });
            renderTags();
        }

        function removeTag(index) {
            currentTags.splice(index, 1);
            renderTags();
        }

        function renderTags() {
            const html = currentTags.map((tag, i) => `
                <div class="tag-item ${tag.type}-tag">
                    <span>${tag.text}</span>
                    <span class="tag-remove" onclick="removeTag(${i})">×</span>
                </div>
            `).join('');
            document.getElementById('tagsDisplay').innerHTML = html;
        }

        function setupEvents() {
            const tagInput = document.getElementById('tagInput');
            tagInput.addEventListener('keypress', e => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addTag();
                }
            });

            const imageInput = document.getElementById('imageInput');
            imageInput.addEventListener('change', e => {
                const file = e.target.files[0];
                if (file) handleImageFile(file);
            });

            const uploadArea = document.getElementById('uploadArea');
            uploadArea.addEventListener('dragover', e => {
                e.preventDefault();
                uploadArea.style.background = 'rgba(168,192,216,0.2)';
            });
            uploadArea.addEventListener('dragleave', () => {
                uploadArea.style.background = '';
            });
            uploadArea.addEventListener('drop', e => {
                e.preventDefault();
                uploadArea.style.background = '';
                const file = e.dataTransfer.files[0];
                if (file?.type.startsWith('image/')) handleImageFile(file);
            });

            document.addEventListener('paste', e => {
                if (!document.getElementById('addModal').classList.contains('active')) return;
                const items = e.clipboardData.items;
                for (let item of items) {
                    if (item.type.startsWith('image/')) {
                        handleImageFile(item.getAsFile());
                        break;
                    }
                }
            });
        }

        function handleImageFile(file) {
            const reader = new FileReader();
            reader.onload = e => {
                currentImageData = e.target.result;
                document.getElementById('imagePreview').src = currentImageData;
                document.getElementById('previewContainer').style.display = 'block';
                document.getElementById('uploadArea').style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        function removeImage() {
            currentImageData = null;
            document.getElementById('previewContainer').style.display = 'none';
            document.getElementById('uploadArea').style.display = 'block';
            document.getElementById('imageInput').value = '';
        }

        init();
    </script>

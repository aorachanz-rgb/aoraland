    <script>
        let portfolios = [];
        let categories = ['デザイン', '開発', 'ライティング', '写真', 'その他'];
        let currentFilter = 'all';
        let currentViewType = 'all';
        let currentEditId = null;
        let currentViewId = null;
        let currentImageData = null;
        let currentTags = [];
        let currentLang = 'ja';

        // Check if persistent storage is available, otherwise use localStorage
        const hasStorage = typeof window.storage !== 'undefined';
        
        // Storage wrapper functions
        async function storageGet(key) {
            if (hasStorage) {
                try {
                    return await window.storage.get(key);
                } catch (e) {
                    console.error('Storage get error:', e);
                    return null;
                }
            } else {
                const value = localStorage.getItem(key);
                return value ? { value } : null;
            }
        }

        async function storageSet(key, value) {
            if (hasStorage) {
                try {
                    await window.storage.set(key, value);
                    return true;
                } catch (e) {
                    console.error('Storage set error:', e);
                    return false;
                }
            } else {
                try {
                    localStorage.setItem(key, value);
                    return true;
                } catch (e) {
                    console.error('LocalStorage set error:', e);
                    return false;
                }
            }
        }

        async function storageDelete(key) {
            if (hasStorage) {
                try {
                    await window.storage.delete(key);
                } catch (e) {
                    console.error('Storage delete error:', e);
                }
            } else {
                localStorage.removeItem(key);
            }
        }

        async function storageList(prefix) {
            if (hasStorage) {
                try {
                    return await window.storage.list(prefix);
                } catch (e) {
                    console.error('Storage list error:', e);
                    return { keys: [] };
                }
            } else {
                const keys = [];
                for (let i = 0; i < localStorage.length; i++) {
                    const key = localStorage.key(i);
                    if (key.startsWith(prefix)) {
                        keys.push(key);
                    }
                }
                return { keys };
            }
        }

        const texts = {
            ja: {
                tagline: '瞬間のコレクション',
                categoryTitle: 'カテゴリー',
                manage: '管理',
                all: 'すべて',
                imageWorks: '画像作品',
                textWorks: 'テキスト作品',
                addWork: '+ 新しい作品',
                manageCat: 'カテゴリー管理',
                addCat: '+ カテゴリーを追加',
                cancel: 'キャンセル',
                save: '保存',
                newWork: '新しい作品',
                editWork: '作品を編集',
                category: 'カテゴリー',
                title: 'タイトル',
                description: '説明',
                optional: '(任意)',
                customTags: 'カスタムタグ',
                image: '画像',
                link: 'リンク',
                uploadText: 'クリック / ドラッグ / Ctrl+V で画像を追加',
                uploadHint: 'JPG、PNG、GIF対応',
                removeImg: '削除',
                edit: '編集',
                delete: '削除',
                noWorks: '作品がまだありません。最初の作品を作成しましょう！',
                viewLink: 'リンクを開く',
                platform: 'プラットフォーム',
